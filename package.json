{
  "name": "mistpine",
  "private": true,
  "version": "0.1.0",
  "description": "A color scheme drawn from fog and pine: palette, spec and brand assets.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "node scripts/build.ts --check",
    "sync": "node scripts/sync.ts && node scripts/build.ts",
    "render": "node scripts/render.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "harfbuzzjs": "^1.6.4",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
